# RIS Performance Dashboard Frontend Environment Configuration

# API Configuration
VITE_API_URL=http://localhost:3001

# WebSocket Configuration
VITE_WEBSOCKET_URL=http://localhost:3001

# Development Configuration
VITE_NODE_ENV=development

# Google OAuth Client ID (web client from Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=

# Dev-only: bypass login (auto-signs you in as a dev admin). Pair with SKIP_AUTH=true on backend.
VITE_BYPASS_AUTH=false
